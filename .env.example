# Copy to .env and fill in. Never commit the real .env.

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Database (SQLite) ---
# DATABASE_URL=sqlite:///./data/stress_app.db

# --- RAG / ChromaDB ---
# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_COLLECTION_NAME=stress_knowledge

# --- NLP models ---
# PHOBERT_STRESS_MODEL_DIR=./models/phobert-stress

# --- API / Frontend ---
# API_HOST=127.0.0.1
# API_PORT=8000
# API_BASE_URL=http://127.0.0.1:8000
