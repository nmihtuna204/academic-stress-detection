# Copy to .env and fill in. Never commit the real .env.

# --- LLM provider ---------------------------------------------------------
# The client speaks the OpenAI API. Leave OPENAI_BASE_URL empty for OpenAI
# itself, or point it at any OpenAI-compatible provider.
#
# IMPORTANT for the study: docs/consent_form_vi.md 4 tells participants their
# text goes to OpenAI. If you change provider, change that document and the
# report too, or the consent you obtained no longer matches what happens.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Groq - free tier, fast, OpenAI-compatible. Console: console.groq.com/keys
# Use gpt-oss-120b: Groq deprecated llama-3.3-70b-versatile for free/developer
# tiers on 2026-06-17 and names gpt-oss-120b as its replacement. Being an
# OpenAI model it also follows the strict-JSON format this project needs.
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_CONCURRENCY=1     # free tier is 8K tokens/min; prompts here are ~1.8K

# OpenRouter - aggregator, some models are free (":free" suffix).
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini via its OpenAI-compatible endpoint. Free tier available.
# OPENAI_API_KEY=AIza...
# OPENAI_MODEL=gemini-2.0-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ollama running locally - no key, no quota, no data leaves the machine.
# Needs `ollama serve` and `ollama pull <model>` first.
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1:8b
# OPENAI_BASE_URL=http://localhost:11434/v1

LLM_TEMPERATURE=0.2
# Concurrent evaluation requests. Lower this to 1 or 2 if a free tier
# starts returning HTTP 429 (rate limited).
# LLM_CONCURRENCY=4
# LLM_TIMEOUT_SECONDS=60

# --- Database (SQLite) ---
# DATABASE_URL=sqlite:///./data/stress_app.db

# --- RAG / ChromaDB ---
# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_COLLECTION_NAME=stress_knowledge

# --- NLP models ---
# PHOBERT_STRESS_MODEL_DIR=./models/phobert-stress

# --- API / Frontend ---
# API_HOST=127.0.0.1
# API_PORT=8000
# API_BASE_URL=http://127.0.0.1:8000
